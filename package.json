    "test:core": "node test/smoke-core.mjs",
    "test:mcp": "node test/smoke-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0"
  },
  "optionalDependencies": {
    "patchright": "^1.63.0"
  }
