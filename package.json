  "description": "MCP server that gives an AI agent full read/write control of a Perchance.org generator's live editor, plus browser-free source access.",
  "type": "commonjs",
  "main": "perch-mcp.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
